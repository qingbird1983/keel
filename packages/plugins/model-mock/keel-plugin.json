{
  "kind": "model",
  "meta": {
    "name": "model-mock",
    "version": "1.0.0",
    "title": "Model Mock",
    "description": "确定性模型剧本（Phase 4 切片③）：进 CI，承载计量/预算/超时/断流与密钥红线断言"
  },
  "permissions": [],
  "resources": {},
  "compensation": { "templates": [] },
