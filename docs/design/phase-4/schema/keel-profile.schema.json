{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.dev/schema/keel-profile.schema.json",
  "title": "Keel Profile",
  "description": "Phase 4 装配清单：声明哪些插件、用哪份报关单、用哪份模块、进哪个 scope。profile 不复制权限/补偿字段（报关单的唯一职责），也不承载任何密钥。结构校验用本 Schema；路径解析、kind 交叉校验、engine↔model/tool 交叉校验由 Host Profile 装配器执行（design/phase-4/01-profile-assembly.md §3/§4）。",
  "type": "object",
  "required": ["version", "name", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "const": 1,
      "description": "profile 格式版本；目前仅 1（未知版本拒绝，不猜兼容）"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "profile 名，kebab-case；缺省 agentId"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 }
      },
      "description": "可选：缺省 agentId = name、sessionId = main"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "manifest", "module"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "清单内唯一；engine.model.ref 指向 model 插件的 id"
          },
          "kind": {
            "enum": ["capability", "policy", "observation", "model", "engine"],
            "description": "必须与所载 manifest 的 kind 相等（装配器交叉校验）"
          },
          "manifest": {
            "type": "string",
            "minLength": 1,
            "description": "相对 profile 文件所在目录的 JSON 报关单路径；绝对路径拒绝"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "相对 profile 文件所在目录的已构建入口（dist/）；绝对路径拒绝"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agentId": { "type": "string", "minLength": 1 },
              "sessionId": { "type": "string", "minLength": 1 }
            },
            "description": "可选：覆盖顶层 scope（逐字段合并）"
          }
        }
      }
    }
  }
}
