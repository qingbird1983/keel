{
  "name": "keel-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "check-size": "bash scripts/check-size",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@keel/cell-runtime": "workspace:*",
    "@keel/core": "workspace:*",
    "@keel/cordis-adapter": "workspace:*",
    "@keel/host": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
